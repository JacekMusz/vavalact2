---
<section id="oferta">
  <div class="section-inner offer-inner">
    <h2 data-i18n="menuItems.offer">Oferta</h2>

    <!-- desktop: plain 3-column grid -->
    <div class="products-grid desktop-grid">
      <div class="product-col">
        <h3 data-i18n="products.liquids">Produkty płynne</h3>
        <ul>
          <li data-i18n="productDetails.liquids.rawMilk">Mleko pełne przerzutowe</li>
          <li data-i18n="productDetails.liquids.skimmedMilk">Mleko odtłuszczone przerzutowe</li>
          <li data-i18n="productDetails.liquids.cream">Śmietana przerzutowa (36%, 40%)</li>
          <li data-i18n="productDetails.liquids.skimmedMilkConcentrate">Koncentrat mleka odtłuszczonego (SMC)</li>
          <li data-i18n="productDetails.liquids.sweetWheyConcentrate">Koncentrat serwatki słodkiej (SWC)</li>
          <li data-i18n="productDetails.liquids.acidWheyConcentrate">Koncentrat serwatki kwaśnej (AWC)</li>
        </ul>
      </div>
      <div class="product-col">
        <h3 data-i18n="products.powders">Proszki mleczne i serwatkowe</h3>
        <ul>
          <li data-i18n="productDetails.powders.skimmedMilkPowder">Mleko odtłuszczone w proszku (SMP)</li>
          <li data-i18n="productDetails.powders.fullCreamMilkPowder">Mleko pełne w proszku (FCMP)</li>
          <li data-i18n="productDetails.powders.sweetWheyPowder">Serwatka słodka w proszku (SWP)</li>
          <li data-i18n="productDetails.powders.acidWheyPowder">Serwatka kwaśna w proszku (AWP)</li>
          <li data-i18n="productDetails.powders.creamPowder">Śmietanka w proszku (42%, 50%)</li>
          <li data-i18n="productDetails.powders.buttermilkPowder">Maślanka w proszku (BMP)</li>
          <li data-i18n="productDetails.powders.wheyProteinConcentrate">Koncentrat białek serwatkowych (WPC)</li>
          <li data-i18n="productDetails.powders.milkProteinConcentrate">Koncentrat białek mlecznych (MPC)</li>
        </ul>
      </div>
      <div class="product-col">
        <h3 data-i18n="products.cheeses">Sery i tłuszcze</h3>
        <ul>
          <li data-i18n="productDetails.cheeses.burro">Masło min. 82%</li>
          <li data-i18n="productDetails.cheeses.burroAnidro">Masło bezwodne</li>
          <li data-i18n="productDetails.cheeses.gouda">Gouda 45% / 48%</li>
          <li data-i18n="productDetails.cheeses.edamer">Edamer 40%</li>
          <li data-i18n="productDetails.cheeses.caglita">Twaróg 40% – 42% – 45% – 48%</li>
          <li data-i18n="productDetails.cheeses.emmentaler">Emmentaler</li>
          <li data-i18n="productDetails.cheeses.cheddar">Cheddar</li>
          <li data-i18n="productDetails.cheeses.mozzarella">Mozzarella 3kg / 9kg / 15kg</li>
        </ul>
      </div>
    </div>

    <!-- mobile: carousel -->
    <div class="offer-carousel mobile-carousel">
      <div class="carousel-viewport">
        <div class="carousel-track">
          <div class="product-col">
            <h3 data-i18n="products.liquids">Produkty płynne</h3>
            <ul>
              <li data-i18n="productDetails.liquids.rawMilk">Mleko pełne przerzutowe</li>
              <li data-i18n="productDetails.liquids.skimmedMilk">Mleko odtłuszczone przerzutowe</li>
              <li data-i18n="productDetails.liquids.cream">Śmietana przerzutowa (36%, 40%)</li>
              <li data-i18n="productDetails.liquids.skimmedMilkConcentrate">Koncentrat mleka odtłuszczonego (SMC)</li>
              <li data-i18n="productDetails.liquids.sweetWheyConcentrate">Koncentrat serwatki słodkiej (SWC)</li>
              <li data-i18n="productDetails.liquids.acidWheyConcentrate">Koncentrat serwatki kwaśnej (AWC)</li>
            </ul>
          </div>
          <div class="product-col">
            <h3 data-i18n="products.powders">Proszki mleczne i serwatkowe</h3>
            <ul>
              <li data-i18n="productDetails.powders.skimmedMilkPowder">Mleko odtłuszczone w proszku (SMP)</li>
              <li data-i18n="productDetails.powders.fullCreamMilkPowder">Mleko pełne w proszku (FCMP)</li>
              <li data-i18n="productDetails.powders.sweetWheyPowder">Serwatka słodka w proszku (SWP)</li>
              <li data-i18n="productDetails.powders.acidWheyPowder">Serwatka kwaśna w proszku (AWP)</li>
              <li data-i18n="productDetails.powders.creamPowder">Śmietanka w proszku (42%, 50%)</li>
              <li data-i18n="productDetails.powders.buttermilkPowder">Maślanka w proszku (BMP)</li>
              <li data-i18n="productDetails.powders.wheyProteinConcentrate">Koncentrat białek serwatkowych (WPC)</li>
              <li data-i18n="productDetails.powders.milkProteinConcentrate">Koncentrat białek mlecznych (MPC)</li>
            </ul>
          </div>
          <div class="product-col">
            <h3 data-i18n="products.cheeses">Sery i tłuszcze</h3>
            <ul>
              <li data-i18n="productDetails.cheeses.burro">Masło min. 82%</li>
              <li data-i18n="productDetails.cheeses.burroAnidro">Masło bezwodne</li>
              <li data-i18n="productDetails.cheeses.gouda">Gouda 45% / 48%</li>
              <li data-i18n="productDetails.cheeses.edamer">Edamer 40%</li>
              <li data-i18n="productDetails.cheeses.caglita">Twaróg 40% – 42% – 45% – 48%</li>
              <li data-i18n="productDetails.cheeses.emmentaler">Emmentaler</li>
              <li data-i18n="productDetails.cheeses.cheddar">Cheddar</li>
              <li data-i18n="productDetails.cheeses.mozzarella">Mozzarella 3kg / 9kg / 15kg</li>
            </ul>
          </div>
        </div>
      </div>
      <div class="carousel-controls">
        <button class="carousel-btn prev" aria-label="Poprzedni">&#8249;</button>
        <button class="carousel-btn next" aria-label="Następny">&#8250;</button>
      </div>
    </div>

  </div>
</section>

<style>
  #oferta {
    background: var(--color-primary-light);
    color: var(--color-dark);
  }

  .offer-inner {
    text-align: left;
    max-width: 1100px;
    width: 100%;
    padding: 2rem;
  }

  .offer-inner h2 {
    text-align: center;
    margin-bottom: 1.5rem;
    position: relative;
    width: fit-content;
    margin-left: auto;
    margin-right: auto;
  }

  .offer-inner h2::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--color-dark);
    transform: scaleX(0);
    transform-origin: center;
  }

  .offer-inner h2.underline-animate::after {
    animation: underline-draw 500ms ease forwards;
  }

  /* desktop grid */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .product-col h3 {
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding-bottom: 0.5rem;
    margin-bottom: 0.6rem;
    border-bottom: 1.5px solid rgba(26, 25, 23, 0.25);
  }

  .product-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .product-col li {
    font-size: 0.825rem;
    padding: 0.28rem 0;
    border-bottom: 1px solid rgba(26, 25, 23, 0.08);
    opacity: 0.85;
  }

  .product-col li:last-child {
    border-bottom: none;
  }

  /* mobile carousel hidden on desktop */
  .mobile-carousel {
    display: none;
  }

  @media (max-width: 1024px) {
    .offer-inner {
      padding: 1.25rem;
    }

    .desktop-grid {
      display: none;
    }

    .mobile-carousel {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-top: 0;
      width: 100%;
    }

    .carousel-viewport {
      overflow: hidden;
      width: 100%;
    }

    .carousel-track {
      display: flex;
      will-change: transform;
    }

    .carousel-track .product-col {
      flex: none;
      box-sizing: border-box;
      padding: 0 0.5rem;
    }

    .carousel-controls {
      display: flex;
      justify-content: center;
      gap: 1rem;
    }

    .carousel-btn {
      background: none;
      border: 2px solid var(--color-dark);
      color: var(--color-dark);
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 50%;
      font-size: 1.75rem;
      line-height: 1;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s, color 0.2s;
    }

    .carousel-btn:hover {
      background: var(--color-dark);
      color: var(--color-primary-light);
    }
  }
</style>

<script>
  const section = document.getElementById('oferta')!;
  const carousel = section.querySelector<HTMLElement>('.offer-carousel')!;
  const track = carousel.querySelector<HTMLElement>('.carousel-track')!;
  const viewport = carousel.querySelector<HTMLElement>('.carousel-viewport')!;
  const prevBtn = carousel.querySelector<HTMLButtonElement>('.carousel-btn.prev')!;
  const nextBtn = carousel.querySelector<HTMLButtonElement>('.carousel-btn.next')!;

  const originals = Array.from(track.children) as HTMLElement[];
  const total = originals.length;
  let trackPos = 0;
  let isAnimating = false;

  function slideWidth() {
    return viewport.offsetWidth;
  }

  function applySlideWidths() {
    const w = slideWidth();
    (Array.from(track.children) as HTMLElement[]).forEach(s => { s.style.width = w + 'px'; });
  }

  function buildTrack() {
    track.innerHTML = '';
    track.appendChild(originals[total - 1].cloneNode(true));
    originals.forEach(item => track.appendChild(item.cloneNode(true)));
    track.appendChild(originals[0].cloneNode(true));

    trackPos = 1;
    applySlideWidths();
    setPosition(false);
  }

  function setPosition(animate: boolean) {
    const w = slideWidth();
    track.style.transition = animate ? 'transform 0.4s ease' : 'none';
    void track.offsetWidth;
    track.style.transform = `translateX(${-trackPos * w}px)`;
  }

  function step(dir: 1 | -1) {
    if (isAnimating) return;
    isAnimating = true;
    trackPos += dir;
    setPosition(true);
  }

  track.addEventListener('transitionend', () => {
    isAnimating = false;
    // jump to real item without animation when reaching a clone
    if (trackPos >= total + 1) {
      trackPos = 1;
      setPosition(false);
    } else if (trackPos <= 0) {
      trackPos = total;
      setPosition(false);
    }
  });

  prevBtn.addEventListener('click', () => step(-1));
  nextBtn.addEventListener('click', () => step(1));

  const ro = new ResizeObserver(() => {
    if (window.getComputedStyle(carousel).display !== 'none') {
      applySlideWidths();
      setPosition(false);
    }
  });
  ro.observe(viewport);

  buildTrack();
</script>
