<section id="kontakt">
  <div class="section-inner">
    <h2 data-i18n="contact">Kontakt</h2>
    <div class="contact-details">
      <div class="contact-row">
        <span>+48 22 428 55 25</span>
      </div>
      <div class="contact-row">
        <span>info@vavalact.pl</span>
      </div>
      <div class="contact-row contact-row--address">
        <span>Vavalact sp. z o.o.</span>
        <span>ul. Wita Stwosza 48/104</span>
        <span>02-661 Warszawa</span>
        <span>NIP: 7010932298</span>
      </div>
    </div>
  </div>
</section>

<style>
  #kontakt {
    background: var(--color-dark);
    color: var(--color-milk);
    display: flex;
    flex-content: center;
  }

  .contact-details {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-row {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    font-size: clamp(1rem, 2vw, 1.15rem);
    margin-bottom: 42px;
    
  }

  .contact-row--address {
    gap: 0.125rem;
  }

  .contact-label {
    font-weight: 700;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.55;
    min-width: 2.5rem;
  }

  h2 {
    position: relative;
    width: fit-content;
    margin-left: auto;
    margin-right: auto;
  }

  h2::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--color-milk);
    transform: scaleX(0);
    transform-origin: center;
  }

  h2.underline-animate::after {
    animation: underline-draw 500ms ease forwards;
  }
</style>
