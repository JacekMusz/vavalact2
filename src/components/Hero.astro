---
const baseUrl = import.meta.env.BASE_URL;
---
<section id="home">
  <img
    src={`${baseUrl}/hero.webp`}
    alt=""
    class="hero-bg"
    loading="eager"
    decoding="async"
  />
  <div class="hero-overlay"></div>
  <div class="section-inner hero-content">
    <img src={`${baseUrl}/logo.svg`} alt="Vavalact" class="hero-logo" />
  </div>
  <div class="scroll-arrow" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </div>
</section>

<style>
  #home {
    background: #0a0a0a;
    align-items: center;
    padding-top: 0;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* ciemna warstwa dla czytelności tekstu */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    animation: fadeOverlay 1s ease forwards;
  }

  @keyframes fadeOverlay {
    to { background: rgba(0, 0, 0, 0); }
  }

  .hero-content {
    position: relative;
    z-index: 1;
  }

  /* invert SVG colors to white for dark hero background */
  .hero-logo {
    width: 100%;
    max-width: 340px;
    height: auto;
  }

  @media (max-width: 1024px) {
    .hero-logo {
      max-width: 220px;
    }
  }

  .scroll-arrow {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    color: var(--color-primary);
    animation: bounce 2s ease-in-out infinite;
  }

  .scroll-arrow svg {
    width: 2.5rem;
    height: 2.5rem;
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(10px); }
  }
</style>
